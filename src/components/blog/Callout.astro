---
interface Props {
  type?: 'info' | 'warning' | 'success' | 'error';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const colors = {
  info: {
    bg: 'rgba(59, 130, 246, 0.1)',
    border: 'rgba(59, 130, 246, 0.5)',
    text: '#60a5fa',
  },
  warning: {
    bg: 'rgba(234, 179, 8, 0.1)',
    border: 'rgba(234, 179, 8, 0.5)',
    text: '#facc15',
  },
  success: {
    bg: 'rgba(34, 197, 94, 0.1)',
    border: 'rgba(34, 197, 94, 0.5)',
    text: '#4ade80',
  },
  error: {
    bg: 'rgba(239, 68, 68, 0.1)',
    border: 'rgba(239, 68, 68, 0.5)',
    text: '#f87171',
  },
};

const style = colors[type];
---

<div
  class="callout"
  style={`background-color: ${style.bg}; border-left: 4px solid ${style.border}; padding: 1.5rem; border-radius: 0.5rem; margin: 2rem 0;`}
>
  {title && (
    <div
      class="callout-title"
      style={`font-weight: 700; color: ${style.text}; margin-bottom: 0.75rem; font-size: 1.125rem;`}
    >
      {title}
    </div>
  )}
  <div class="callout-content" style="color: var(--text-secondary);">
    <slot />
  </div>
</div>
