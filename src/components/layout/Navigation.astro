---
import { navLinks } from '@/lib/navigation';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Check if we're on a blog page
const isBlogPage = Astro.url.pathname.startsWith('/blog');

// For blog pages, prepend the homepage path to hash links
const localizedNavLinks = navLinks.map((link) => ({
  ...link,
  label: t(`nav.${link.label}`),
  href: isBlogPage ? `/${link.href}` : link.href,
}));
const contactHref = isBlogPage ? '/#contact' : '#contact';
---

<nav class="fixed top-0 left-0 right-0 z-50 pointer-events-none" id="main-nav">
  <div class="nav-bar container-custom pointer-events-auto">
    <div class="flex items-center justify-between h-20 md:h-24">
      <!-- Logo -->
      <a
        href="/"
        class="brand-mark flex items-center hover:opacity-70 transition-all duration-700 hover:scale-105"
        aria-label="Home"
      >
        <svg
          class="w-11 h-11 md:w-12 md:h-12"
          viewBox="0 0 357 356"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M60 0V136.5H129V0H189.5V129.5L254 60.5H206.5V0H333.5L0 355.5V0H60ZM60 197V268L125.5 197H60Z"
            fill="white"></path>
          <path
            d="M263 273H207V355H263C310.5 355 357 309 357 243.5V0L297 62.5V243.5C297 266.755 287.457 290.479 263 295.5V273Z"
            fill="white"></path>
          <path d="M189 354.5V178.5L129 242.5V354.5H189Z" fill="white"></path>
        </svg>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        {
          localizedNavLinks.map((link) => (
            <a
              href={link.href}
              data-nav-link
              data-section={link.href.replace('#', '')}
              class="nav-link relative px-4 py-2 overflow-hidden rounded-lg text-sm uppercase tracking-widest font-light transition-colors text-text-secondary hover:text-primary"
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <!-- Connect Button -->
      <div class="hidden md:flex items-center gap-6">
        <a
          href={contactHref}
          data-nav-link
          data-section="contact"
          class="connect-button relative px-6 py-3 border border-primary text-primary rounded-full font-light text-sm overflow-hidden"
        >
          {t('common.getInTouch')}
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="mobile-menu-button md:hidden"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-label={t('nav.menu')}
        data-close-label={t('nav.close')}
        type="button"
      >
        <span class="mobile-menu-button__label">{t('nav.menu')}</span>
        <span class="mobile-menu-button__icon" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="mobile-menu md:hidden" aria-hidden="true" inert>
    <div class="mobile-menu__monogram" aria-hidden="true">HJ</div>
    <div class="mobile-menu__content container-custom">
      <div class="mobile-menu__links">
        {
          localizedNavLinks.map((link, index) => (
            <a
              href={link.href}
              data-nav-link
              data-section={link.href.replace('#', '')}
              class="mobile-nav-link"
              style={`--menu-index: ${index}`}
            >
              <span class="mobile-nav-link__mark" aria-hidden="true">
                ↬
              </span>
              <span class="mobile-nav-link__label">{link.label}</span>
              <span class="mobile-nav-link__arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))
        }
      </div>

      <div class="mobile-menu__footer">
        <span class="mobile-menu__signature">Héctor Jaraba</span>
        <a
          href={contactHref}
          data-nav-link
          data-section="contact"
          class="mobile-nav-link mobile-menu__contact"
          style={`--menu-index: ${localizedNavLinks.length}`}
        >
          <span>{t('common.getInTouch')}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</nav>

<style>
  @reference '../../styles/global.css';

  .nav-bar {
    position: relative;
    z-index: 2;
  }

  .mobile-menu-button {
    display: inline-flex;
    min-width: 6.5rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--border-default);
    border-radius: 999px;
    color: var(--text-primary);
    background: rgb(var(--bg-900-rgb) / 0.72);
    backdrop-filter: blur(12px);
    transition:
      color 240ms var(--ease-out),
      background-color 240ms var(--ease-out),
      border-color 240ms var(--ease-out);
  }

  .mobile-menu-button__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mobile-menu-button__icon {
    position: relative;
    display: block;
    width: 1.125rem;
    height: 0.75rem;
  }

  .mobile-menu-button__icon span {
    position: absolute;
    right: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition:
      top 300ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu-button__icon span:first-child {
    top: 0.125rem;
  }

  .mobile-menu-button__icon span:last-child {
    top: 0.625rem;
  }

  .mobile-menu-button[aria-expanded='true'] {
    color: var(--bg-900);
    background: var(--primary);
    border-color: var(--primary);
  }

  .mobile-menu-button[aria-expanded='true'] .mobile-menu-button__icon span:first-child,
  .mobile-menu-button[aria-expanded='true'] .mobile-menu-button__icon span:last-child {
    top: 0.375rem;
  }

  .mobile-menu-button[aria-expanded='true'] .mobile-menu-button__icon span:first-child {
    transform: rotate(45deg);
  }

  .mobile-menu-button[aria-expanded='true'] .mobile-menu-button__icon span:last-child {
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    height: 100vh;
    height: 100dvh;
    visibility: hidden;
    pointer-events: none;
    overflow: hidden;
    color: var(--text-primary);
    background:
      radial-gradient(
        circle at 88% 46%,
        rgb(var(--accent-purple-rgb) / 0.28) 0%,
        rgb(var(--accent-purple-rgb) / 0.08) 24%,
        transparent 52%
      ),
      linear-gradient(145deg, var(--bg-900) 0%, var(--surface-deep) 100%);
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 620ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 620ms;
  }

  .mobile-menu::before {
    content: '';
    position: absolute;
    top: 42%;
    right: -28%;
    width: 92vw;
    aspect-ratio: 1;
    border: 1px solid rgb(var(--primary-rgb) / 0.16);
    border-radius: 50%;
    opacity: 0;
    transform: translateY(-50%) scale(0.72);
    transition:
      opacity 500ms var(--ease-out) 160ms,
      transform 900ms cubic-bezier(0.16, 1, 0.3, 1) 80ms;
  }

  .mobile-menu.is-open {
    visibility: visible;
    pointer-events: auto;
    clip-path: inset(0);
    transition-delay: 0s;
  }

  .mobile-menu.is-open::before {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }

  .mobile-menu__monogram {
    position: absolute;
    right: -0.08em;
    bottom: -0.16em;
    color: transparent;
    font-size: min(58vw, 18rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.08em;
    -webkit-text-stroke: 1px rgb(var(--primary-rgb) / 0.1);
    opacity: 0;
    transform: translate3d(10%, 12%, 0);
    transition:
      opacity 650ms var(--ease-out) 220ms,
      transform 800ms cubic-bezier(0.16, 1, 0.3, 1) 140ms;
    pointer-events: none;
    user-select: none;
  }

  .mobile-menu.is-open .mobile-menu__monogram {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .mobile-menu__content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: 1fr auto;
    height: 100%;
    padding-top: max(7rem, calc(5.5rem + env(safe-area-inset-top)));
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    overflow-y: auto;
  }

  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    align-self: center;
    width: 100%;
  }

  .mobile-menu__links > .mobile-nav-link {
    position: relative;
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-primary);
    text-decoration: none;
    opacity: 0;
    overflow: hidden;
    transform: translate3d(0, 2rem, 0);
    transition:
      color 220ms var(--ease-out),
      border-color 220ms var(--ease-out),
      opacity 480ms var(--ease-out),
      transform 620ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0ms;
  }

  .mobile-menu__links > .mobile-nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(var(--primary-rgb) / 0.14), transparent 74%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu.is-open .mobile-menu__links > .mobile-nav-link {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition-delay: calc(150ms + var(--menu-index) * 75ms);
  }

  .mobile-nav-link__mark {
    color: var(--primary);
    font-size: 1.15rem;
    transform: translateX(0);
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-nav-link__label {
    font-size: clamp(2.75rem, min(15.5vw, 9vh), 4.75rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .mobile-nav-link__arrow {
    color: var(--primary);
    font-size: 1.35rem;
    opacity: 0.6;
    transform: translate3d(-0.5rem, 0.5rem, 0);
    transition:
      opacity 260ms var(--ease-out),
      transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 420ms var(--ease-out),
      transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu.is-open .mobile-menu__footer {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 360ms;
  }

  .mobile-menu__signature {
    max-width: 7rem;
    color: var(--text-tertiary);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .mobile-menu__contact {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.75rem 1.125rem;
    border-radius: 999px;
    color: var(--bg-900);
    background: var(--primary);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      color 220ms var(--ease-out),
      background-color 220ms var(--ease-out),
      transform 150ms var(--ease-out);
  }

  .mobile-menu__contact:active {
    transform: scale(0.97);
  }

  :global(body.mobile-menu-open) {
    overflow: hidden;
  }

  @media (hover: hover) {
    .mobile-menu-button:hover {
      color: var(--primary);
      border-color: var(--primary);
    }

    .mobile-menu-button[aria-expanded='true']:hover {
      color: var(--bg-900);
    }

    .mobile-menu__links > .mobile-nav-link:hover,
    .mobile-menu__links > .mobile-nav-link:focus-visible {
      color: var(--primary-bright);
      border-color: var(--border-default);
    }

    .mobile-menu__links > .mobile-nav-link:hover::before,
    .mobile-menu__links > .mobile-nav-link:focus-visible::before {
      transform: scaleX(1);
    }

    .mobile-menu__links > .mobile-nav-link:hover .mobile-nav-link__mark,
    .mobile-menu__links > .mobile-nav-link:focus-visible .mobile-nav-link__mark {
      transform: translateX(0.2rem);
    }

    .mobile-menu__links > .mobile-nav-link:hover .mobile-nav-link__arrow,
    .mobile-menu__links > .mobile-nav-link:focus-visible .mobile-nav-link__arrow {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }

    .mobile-menu__contact:hover,
    .mobile-menu__contact:focus-visible {
      color: var(--primary);
      background: var(--surface-lighter);
    }
  }

  @media (max-height: 620px) and (orientation: landscape) {
    .mobile-menu__content {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: 1fr;
      align-items: end;
      gap: 2rem;
      padding-top: 6rem;
    }

    .mobile-nav-link__label {
      font-size: clamp(2.25rem, 12vh, 3.5rem);
    }

    .mobile-menu__footer {
      flex-direction: column;
      align-items: flex-end;
      border-top: 0;
    }
  }

  @media (min-width: 768px) {
    .mobile-menu-button {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-menu::before,
    .mobile-menu__monogram,
    .mobile-menu__links > .mobile-nav-link,
    .mobile-menu__footer,
    .mobile-menu-button__icon span {
      transition: none;
    }

    .mobile-menu__links > .mobile-nav-link,
    .mobile-menu__footer,
    .mobile-menu__monogram {
      opacity: 1;
      transform: none;
    }
  }

  .nav-link,
  .connect-button {
    --fill-width: 0%;
  }

  .nav-link::before,
  .connect-button::before {
    content: '';
    @apply absolute top-0 left-0 h-full -z-10 transition-none;
    width: var(--fill-width);
  }

  .nav-link::before {
    @apply rounded-lg;
    background: rgb(var(--primary-rgb) / 0.08);
  }

  .nav-link.active {
    @apply text-primary;
  }

  .nav-link.active::before {
    background: rgb(var(--primary-rgb) / 0.14);
  }

  .nav-link:not(.active):hover::before {
    @apply w-full transition-[width] duration-300 ease-in-out;
    background: rgb(var(--primary-rgb) / 0.12);
  }

  .connect-button::before {
    @apply rounded-full;
    background: rgb(var(--primary-rgb) / 0.1);
  }

  .connect-button.active::before {
    @apply bg-primary;
  }

  .connect-button.active {
    @apply text-bg-900;
  }

  .connect-button:not(.active):hover::before {
    @apply w-full transition-[width] duration-300 ease-in-out bg-primary;
  }

  .connect-button:not(.active):hover {
    @apply text-bg-900;
  }
</style>

<script>
  import { updateClock, getCurrentSectionIndex, updateNavProgress } from '@/lib/navigation';
  import { onInit } from '@/lib/dom';

  function initNavigation() {
    const nav = document.getElementById('main-nav');
    if (!nav || nav.dataset.navigationInitialized === 'true') return;
    nav.dataset.navigationInitialized = 'true';

    const isBlogPage = window.location.pathname.startsWith('/blog');

    // Mobile menu toggle
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const mainContent = document.getElementById('main-content');
    const menuButtonLabel = mobileMenuButton?.querySelector<HTMLElement>(
      '.mobile-menu-button__label'
    );
    let previouslyFocusedElement: HTMLElement | null = null;

    const getMobileMenuFocusableElements = () => {
      if (!mobileMenu || !mobileMenuButton) return [];

      return [
        mobileMenuButton,
        ...Array.from(
          mobileMenu.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
          )
        ),
      ];
    };

    const setMobileMenuState = (isOpen: boolean, restoreFocus = true) => {
      if (!mobileMenuButton || !mobileMenu) return;

      const menuLabel = mobileMenuButton.dataset.menuLabel || 'Menu';
      const closeLabel = mobileMenuButton.dataset.closeLabel || 'Close';

      mobileMenuButton.setAttribute('aria-expanded', String(isOpen));
      mobileMenuButton.setAttribute('aria-label', isOpen ? closeLabel : menuLabel);
      if (menuButtonLabel) menuButtonLabel.textContent = isOpen ? closeLabel : menuLabel;
      mobileMenu.classList.toggle('is-open', isOpen);
      mobileMenu.setAttribute('aria-hidden', String(!isOpen));
      mobileMenu.toggleAttribute('inert', !isOpen);
      mainContent?.toggleAttribute('inert', isOpen);
      nav.classList.toggle('menu-open', isOpen);
      document.body.classList.toggle('mobile-menu-open', isOpen);

      if (isOpen) {
        previouslyFocusedElement = document.activeElement as HTMLElement;
        requestAnimationFrame(() => {
          mobileMenu.querySelector<HTMLElement>('.mobile-nav-link')?.focus();
        });
      } else if (restoreFocus) {
        previouslyFocusedElement?.focus();
      }
    };

    mobileMenuButton?.addEventListener('click', () => {
      const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
      setMobileMenuState(!isExpanded);
    });

    // Close mobile menu when a link is clicked
    const mobileNavLinks = mobileMenu?.querySelectorAll('.mobile-nav-link') || [];
    mobileNavLinks.forEach((link) => {
      link.addEventListener('click', () => {
        setMobileMenuState(false, false);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (mobileMenuButton?.getAttribute('aria-expanded') !== 'true') return;

      if (event.key === 'Escape') {
        event.preventDefault();
        setMobileMenuState(false);
        return;
      }

      if (event.key !== 'Tab') return;

      const focusableElements = getMobileMenuFocusableElements();
      const firstElement = focusableElements[0];
      const lastElement = focusableElements.at(-1);

      if (!firstElement || !lastElement) return;

      if (event.shiftKey && document.activeElement === firstElement) {
        event.preventDefault();
        lastElement.focus();
      } else if (!event.shiftKey && document.activeElement === lastElement) {
        event.preventDefault();
        firstElement.focus();
      }
    });

    window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
      if (event.matches) setMobileMenuState(false, false);
    });

    // Clock functionality
    const clockElement = document.getElementById('clock-time');
    const updateClockDisplay = () => {
      if (clockElement) clockElement.textContent = updateClock();
    };

    updateClockDisplay();
    setInterval(updateClockDisplay, 1000);

    // Blog-specific: Hide navigation on scroll down and add glass effect
    if (isBlogPage && nav) {
      let lastScrollTop = 0;
      let scrollTimeout: number;

      const handleBlogScroll = () => {
        const scrollTop = window.scrollY;

        // Add glass effect when scrolled down
        if (scrollTop > 50) {
          nav.style.background = 'rgb(var(--bg-800-rgb) / 0.82)';
          nav.style.backdropFilter = 'blur(12px)';
          nav.style.webkitBackdropFilter = 'blur(12px)';
          nav.style.borderBottom = '1px solid var(--border-subtle)';
        } else {
          nav.style.background = 'transparent';
          nav.style.backdropFilter = 'none';
          nav.style.webkitBackdropFilter = 'none';
          nav.style.borderBottom = 'none';
        }

        if (scrollTop > 100) {
          // Only hide after scrolling past 100px
          if (scrollTop > lastScrollTop) {
            // Scrolling down - hide nav
            nav.style.transform = 'translateY(-100%)';
            nav.style.transition =
              'transform 0.3s ease-in-out, background 0.3s ease-in-out, backdrop-filter 0.3s ease-in-out';
          } else {
            // Scrolling up - show nav
            nav.style.transform = 'translateY(0)';
            nav.style.transition =
              'transform 0.3s ease-in-out, background 0.3s ease-in-out, backdrop-filter 0.3s ease-in-out';
          }
        } else {
          // At top - always show
          nav.style.transform = 'translateY(0)';
          nav.style.transition = 'background 0.3s ease-in-out, backdrop-filter 0.3s ease-in-out';
        }

        lastScrollTop = scrollTop;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (scrollTimeout) cancelAnimationFrame(scrollTimeout);
          scrollTimeout = requestAnimationFrame(handleBlogScroll);
        },
        { passive: true }
      );

      // Initial check
      handleBlogScroll();

      return; // Skip section tracking for blog pages
    }

    // Get all nav links for smooth scroll behavior
    const allNavLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    // Get desktop nav links only for progress tracking
    const desktopNavLinks = document.querySelectorAll('[data-nav-link]:not(.mobile-nav-link)');

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const navigationKeys = new Set([
      'ArrowDown',
      'ArrowLeft',
      'ArrowRight',
      'ArrowUp',
      'End',
      'Home',
      'PageDown',
      'PageUp',
      ' ',
    ]);
    let cancelActiveScroll: (() => void) | null = null;

    const smoothScrollTo = (target: number) => {
      cancelActiveScroll?.();

      const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      const destination = Math.min(Math.max(target, 0), maxScroll);
      const start = window.scrollY;
      const distance = destination - start;

      if (reducedMotion.matches || Math.abs(distance) < 2) {
        window.scrollTo({ top: destination, behavior: 'auto' });
        return;
      }

      const duration = Math.min(900, Math.max(480, 420 + Math.abs(distance) * 0.08));
      const startedAt = performance.now();
      const root = document.documentElement;
      const previousScrollBehavior = root.style.scrollBehavior;
      let animationFrame = 0;
      let finished = false;

      // The site uses CSS smooth scrolling, so disable it while the frame-by-frame
      // animation is active to avoid stacking two scroll animations.
      root.style.scrollBehavior = 'auto';

      const cleanup = () => {
        if (finished) return;
        finished = true;
        cancelAnimationFrame(animationFrame);
        root.style.scrollBehavior = previousScrollBehavior;
        window.removeEventListener('wheel', interruptScroll);
        window.removeEventListener('touchstart', interruptScroll);
        window.removeEventListener('pointerdown', interruptScroll);
        document.removeEventListener('keydown', interruptWithKeyboard);
        cancelActiveScroll = null;
      };

      const interruptScroll = () => cleanup();
      const interruptWithKeyboard = (event: KeyboardEvent) => {
        if (navigationKeys.has(event.key)) cleanup();
      };

      window.addEventListener('wheel', interruptScroll, { passive: true });
      window.addEventListener('touchstart', interruptScroll, { passive: true });
      window.addEventListener('pointerdown', interruptScroll, { passive: true });
      document.addEventListener('keydown', interruptWithKeyboard);
      cancelActiveScroll = cleanup;

      const animate = (now: number) => {
        const progress = Math.min((now - startedAt) / duration, 1);
        const eased =
          progress < 0.5
            ? 4 * progress * progress * progress
            : 1 - Math.pow(-2 * progress + 2, 3) / 2;

        window.scrollTo(0, start + distance * eased);

        if (progress < 1) {
          animationFrame = requestAnimationFrame(animate);
        } else {
          cleanup();
        }
      };

      animationFrame = requestAnimationFrame(animate);
    };

    // Give every in-page destination the same continuous navigation motion.
    allNavLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

        const sectionId = link.getAttribute('data-section');
        const heroSection = document.getElementById('hero');
        const section = sectionId ? document.getElementById(sectionId) : null;
        if (!sectionId || !heroSection || !section) return;

        let targetScroll = section.getBoundingClientRect().top + window.scrollY;

        if (sectionId === 'home') {
          targetScroll = 0;
        } else if (sectionId === 'about') {
          // Scroll to approximately 50% of hero section to show the about slide
          // The about slide becomes fully visible at around 50% of the hero scroll
          targetScroll = heroSection.offsetHeight * 0.5;
        }

        e.preventDefault();
        const hash = link.hash || `#${sectionId}`;
        if (window.location.hash !== hash) history.pushState(null, '', hash);
        smoothScrollTo(targetScroll);
      });
    });

    const updateActiveSection = () => {
      const scrollTop = window.scrollY;
      const shouldShowGlass = scrollTop > 50;

      // Add glass effect when scrolled down
      if (nav && nav.dataset.scrolled !== String(shouldShowGlass)) {
        nav.dataset.scrolled = String(shouldShowGlass);
        if (shouldShowGlass) {
          nav.style.backdropFilter = 'blur(12px)';
          nav.style.webkitBackdropFilter = 'blur(12px)';
          nav.style.transition = 'backdrop-filter 0.3s ease-in-out';
        } else {
          nav.style.backdropFilter = 'none';
          nav.style.webkitBackdropFilter = 'none';
          nav.style.transition = 'backdrop-filter 0.3s ease-in-out';
        }
      }

      // Progress indicators are hidden on mobile, so avoid their layout reads entirely.
      if (window.innerWidth < 768) return;

      const windowHeight = window.innerHeight;
      const documentHeight = document.documentElement.scrollHeight;

      const currentIndex = getCurrentSectionIndex(
        desktopNavLinks,
        scrollTop,
        windowHeight,
        documentHeight
      );
      updateNavProgress(desktopNavLinks, currentIndex, scrollTop, windowHeight, documentHeight);
    };

    let scrollTimeout: number;
    window.addEventListener(
      'scroll',
      () => {
        if (scrollTimeout) cancelAnimationFrame(scrollTimeout);
        scrollTimeout = requestAnimationFrame(updateActiveSection);
      },
      { passive: true }
    );

    updateActiveSection();
  }

  // Initialize navigation on page load and navigation
  onInit(initNavigation);
</script>
