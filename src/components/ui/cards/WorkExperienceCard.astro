---
// WorkExperienceCard Component
export interface Props {
  period: string;
  title: string;
  company: string;
  description?: string;
  index: number;
}

const { period, title, company, description, index } = Astro.props;
---

<div class="job-card-wrapper" data-job-index={index}>
  <div class="job-card">
    <h3 class="job-title">
      {title}
    </h3>
    <p class="job-company">
      {company}
    </p>
    {description && <p class="job-description">{description}</p>}
  </div>
  <div class="job-connector">
    <span class="connector-dot"></span>
  </div>
  <span class="job-period">
    {period}
  </span>
</div>

<style>
  .job-card-wrapper {
    flex-shrink: 0;
    width: 50vw;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    opacity: 0.3;
    transform: scale(0.9);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .job-card-wrapper.active {
    opacity: 1;
    transform: scale(1);
  }

  .job-card {
    backdrop-filter: blur(20px);
    padding: 2.5rem;
    position: relative;
    transition: all 0.3s ease;
    width: 100%;
    max-width: 450px;
    background: rgb(var(--bg-900-rgb) / 0.9);
  }

  .job-card::before,
  .job-card::after {
    content: '';
    position: absolute;
    width: 12px;
    height: 12px;
    border: 3px solid var(--primary);
  }

  .job-card::before {
    top: -3px;
    left: -3px;
    border-right: 0;
    border-bottom: 0;
  }

  .job-card::after {
    bottom: -3px;
    right: -3px;
    border-left: 0;
    border-top: 0;
  }

  .job-period {
    display: inline-block;
    font-size: 1rem;
    color: var(--text-secondary);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    opacity: 0.7;
  }

  .job-title {
    font-size: 1.75rem;
    font-weight: 200;
    color: var(--primary);
    margin-bottom: 0.5rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .job-company {
    font-size: 1.125rem;
    color: var(--text-primary);
    font-weight: 600;
    opacity: 0.9;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .job-description {
    font-size: 1rem;
    color: var(--text-tertiary);
    line-height: 1.7;
    font-weight: 300;
  }

  .job-connector {
    width: 3px;
    height: 100px;
    background: var(--primary);
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .connector-dot {
    position: absolute;
    bottom: -4px;
    width: 14px;
    height: 14px;
    background: var(--primary);
    border-radius: 50%;
    box-shadow: var(--shadow-glow);
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .job-card-wrapper {
      padding: 0 2em;
    }
  }

  @media (max-width: 450px) {
    .job-card-wrapper {
      width: 100vw;
    }
    .job-title {
      font-size: 1.2rem;
    }

    .job-company {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .job-card-wrapper {
      opacity: 1 !important;
      transform: scale(1) !important;
    }

    * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
