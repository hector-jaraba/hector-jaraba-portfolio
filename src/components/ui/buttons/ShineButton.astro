---
interface Props {
  text?: string;
  as?: 'button' | 'link';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  size?: 'sm' | 'md' | 'lg';
  variant?: 'primary' | 'accent' | 'ghost';
  class?: string;
  id?: string;
  disabled?: boolean;
  ariaLabel?: string;
  target?: '_blank' | '_self' | '_parent' | '_top';
  download?: boolean | string;
}

const {
  text,
  as = 'button',
  href = '#',
  type = 'button',
  size,
  variant = 'primary',
  class: className = '',
  id,
  disabled = false,
  ariaLabel,
  target,
  download,
} = Astro.props;

const buttonClasses = [
  'shine-button',
  size ? `shine-button--${size}` : 'shine-button--responsive',
  `shine-button--${variant}`,
  className,
];
---

{
  as === 'link' && (
    <a
      class:list={buttonClasses}
      id={id}
      href={href}
      role="button"
      aria-label={ariaLabel}
      target={target}
      download={download}
    >
      <span class="shine-button__content">
        {text}
        <slot />
      </span>
    </a>
  )
}

{
  as === 'button' && (
    <button
      class:list={buttonClasses}
      id={id}
      type={type}
      disabled={disabled}
      aria-label={ariaLabel}
    >
      <span class="shine-button__content">
        {text}
        <slot />
      </span>
    </button>
  )
}

<style>
  @reference '../../../styles/global.css';

  @property --shine-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  .shine-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: var(--radius-lg);
    font-family: var(--font-sans);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    background: var(--shine-button-surface);
    transition:
      background-color var(--duration-normal) var(--ease-in-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .shine-button::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 1px;
    border-radius: inherit;
    pointer-events: none;
    background: conic-gradient(
      from var(--shine-angle, 0deg),
      transparent 0deg,
      var(--shine-button-glow-start) 18deg,
      var(--shine-button-border) 36deg,
      var(--shine-button-glow-end) 54deg,
      transparent 72deg
    );
    animation: rotate-shine 3s linear infinite;
    animation-play-state: var(--shine-play-state, running);
    mask-image:
      linear-gradient(#000 0 0),
      linear-gradient(#000 0 0);
    mask-origin: content-box, border-box;
    mask-clip: content-box, border-box;
    mask-composite: exclude;
    -webkit-mask-image:
      linear-gradient(#000 0 0),
      linear-gradient(#000 0 0);
    -webkit-mask-origin: content-box, border-box;
    -webkit-mask-clip: content-box, border-box;
    -webkit-mask-composite: xor;
  }

  @keyframes rotate-shine {
    to {
      --shine-angle: 360deg;
    }
  }

  /* Sizes */

  .shine-button--responsive {
    @apply py-2.5 px-5 text-sm rounded-md md:py-4 md:px-7 md:text-base md:rounded-lg lg:py-5 lg:px-8 lg:text-lg lg:rounded-xl;
  }
  .shine-button--sm {
    padding: 0.625rem 1.25rem;
    font-size: 0.875rem;
    border-radius: var(--radius-md);
  }

  .shine-button--md {
    padding: 1rem 1.75rem;
    font-size: 1rem;
    border-radius: var(--radius-lg);
  }

  .shine-button--lg {
    padding: 1.25rem 2rem;
    font-size: 1.125rem;
    border-radius: var(--radius-xl);
  }

  .shine-button--primary {
    --shine-button-surface: rgb(var(--accent-purple-rgb) / 0.1);
    --shine-button-border: var(--primary);
    --shine-button-glow-start: var(--primary-bright);
    --shine-button-glow-end: var(--accent-purple);
    color: var(--primary);
  }

  .shine-button--primary:hover {
    --shine-button-surface: rgb(var(--accent-purple-rgb) / 0.2);
  }

  .shine-button--accent {
    --shine-button-surface: rgb(var(--accent-blue-rgb) / 0.1);
    --shine-button-border: var(--accent-blue);
    --shine-button-glow-start: var(--accent-lavender);
    --shine-button-glow-end: var(--accent-purple);
    color: var(--accent-blue);
  }

  .shine-button--accent:hover {
    --shine-button-surface: rgb(var(--accent-blue-rgb) / 0.2);
  }

  .shine-button--ghost {
    --shine-button-surface: rgba(255, 255, 255, 0.03);
    --shine-button-border: var(--text-primary);
    --shine-button-glow-start: rgba(255, 255, 255, 0.7);
    --shine-button-glow-end: rgba(255, 255, 255, 0.25);
    color: var(--text-primary);
  }

  .shine-button--ghost:hover {
    --shine-button-surface: rgba(255, 255, 255, 0.06);
  }

  .shine-button:hover {
    transform: translateY(-2px);
  }

  .shine-button:active {
    transform: translateY(0);
  }

  .shine-button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .shine-button:disabled,
  .shine-button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .shine-button__content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .shine-button {
      transition: none;
    }

    .shine-button::before {
      animation: none;
      --shine-angle: 45deg;
    }

    .shine-button:hover {
      transform: none;
    }
  }
</style>
