---
// Animated Rectangle Icon
---

<svg width="60" height="60" viewBox="0 0 60 60">
  <rect
    class="morphing-rect"
    x="15"
    y="15"
    width="30"
    height="30"
    stroke="currentColor"
    stroke-width="1"
    fill="none"
  />
  <line x1="30" y1="10" x2="30" y2="50" stroke="currentColor" stroke-width="1" />
</svg>

<style>
  .morphing-rect {
    animation: morph-rect 4s ease-in-out infinite;
  }

  @keyframes morph-rect {
    0%,
    100% {
      rx: 0px;
      ry: 0px;
    }
    50% {
      rx: 15px;
      ry: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .morphing-rect {
      animation: none;
    }
  }
</style>
