---
// Tech Stack Section Component
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { translations } from '@/i18n/utils';
import DiffusedCircles from '@/components/effects/DiffusedCircles.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const technologies = translations[lang].techStack.technologies;
const circles = [
  {
    top: '50px',
    left: '0px',
    size: 400,
    color: 'var(--accent-purple)',
    opacity: 0.5,
    blur: 80, // Reduced from 120 for better performance
    animate: true,
  },
  {
    bottom: '50px', // 190px = half of 380px size
    right: '-15px', // Keeps circle fully inside at bottom-right
    size: 400,
    color: 'var(--accent-purple)',
    opacity: 0.6,
    blur: 60, // Reduced from 100 for better performance
    animate: true,
    animationDuration: 15,
  },
];
---

<section id="stack" class="section-full">
  <DiffusedCircles circles={circles} zIndex={0} />
  <div class="section-content bg-surface">
    <h2 class="section-title scroll-reveal text-center">{t('techStack.title')}</h2>
    <p class="section-subtitle scroll-reveal delay-1 text-center">
      {t('techStack.subtitle')}
    </p>

    <!-- Infinite Marquee -->
    <div class="marquee-container">
      <div class="marquee">
        <div class="marquee-content">
          {technologies[0].map((tech: string) => <span class="brand-name">{tech}</span>)}
        </div>
        <div class="marquee-content" aria-hidden="true">
          {technologies[0].map((tech: string) => <span class="brand-name">{tech}</span>)}
        </div>
      </div>
    </div>

    <!-- Second row reverse direction -->
    <div class="marquee-container">
      <div class="marquee marquee-reverse">
        <div class="marquee-content">
          {technologies[1].map((tech: string) => <span class="brand-name">{tech}</span>)}
        </div>
        <div class="marquee-content" aria-hidden="true">
          {technologies[1].map((tech: string) => <span class="brand-name">{tech}</span>)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Tech Stack Section */
  .section-full {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    scroll-snap-align: start;
    padding: 4rem 2rem 10rem 2rem;
  }

  .section-content {
    width: 100%;
    max-width: 1400px;
    padding: 6rem 2rem 3rem 2rem;
    border: 2px solid var(--border-strong);
    border-radius: 20px;
    margin: 0 auto;
  }

  .bg-surface {
    background:
      radial-gradient(circle at 20% 50%, rgb(var(--accent-purple-rgb) / 0.09) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgb(var(--primary-rgb) / 0.07) 0%, transparent 50%),
      var(--surface);
    position: relative;
  }

  .bg-surface::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgb(var(--primary-rgb) / 0.012) 2px,
        rgb(var(--primary-rgb) / 0.012) 4px
      ),
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 2px,
        rgb(var(--primary-rgb) / 0.012) 2px,
        rgb(var(--primary-rgb) / 0.012) 4px
      );
    pointer-events: none;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 2rem;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text-tertiary);
    font-weight: 300;
    margin-bottom: 6rem;
  }

  .text-center {
    text-align: center;
  }

  .marquee-container {
    margin: 3rem 0;
    overflow: hidden;
    position: relative;
  }

  .marquee {
    display: flex;
    user-select: none;
  }

  .marquee-content {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    min-width: 100%;
    animation: marquee 60s linear infinite;
  }

  .section-full.animations-managed:not(.is-animation-active) .marquee-content {
    animation-play-state: paused;
  }

  .marquee-reverse .marquee-content {
    animation: marquee-reverse 60s linear infinite;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  @keyframes marquee-reverse {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(0);
    }
  }

  .brand-name {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-tertiary);
    letter-spacing: 0.1em;
    transition: color 0.3s ease;
    white-space: nowrap;
    margin: 0 1em;
  }

  .brand-name:hover {
    color: var(--primary);
  }

  /* Mobile responsive adjustments */
  @media (max-width: 768px) {
    .brand-name {
      font-size: 1.5rem;
      margin: 0 0.5em;
    }
  }

  /* Scroll Reveal Animations */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .scroll-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .delay-1 {
    transition-delay: 0.1s;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-reveal {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Scroll Reveal Animation for Tech Stack Section
  function initScrollReveal() {
    const section = document.getElementById('stack');
    if (!section || section.dataset.initialized === 'true') return;
    section.dataset.initialized = 'true';

    const revealElements = document.querySelectorAll('#stack .scroll-reveal');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: '0px 0px -100px 0px',
      }
    );

    revealElements.forEach((el) => observer.observe(el));

    section.classList.add('animations-managed');
    const animationObserver = new IntersectionObserver(
      ([entry]) => section.classList.toggle('is-animation-active', entry.isIntersecting),
      { rootMargin: '200px 0px' }
    );
    animationObserver.observe(section);
  }

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollReveal);
  } else {
    initScrollReveal();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', initScrollReveal);
</script>
