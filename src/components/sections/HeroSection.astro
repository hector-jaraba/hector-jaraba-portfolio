---
import GlassEffect from '@/components/effects/GlassEffect.astro';
import ShineButton from '@/components/ui/buttons/ShineButton.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import BlinkingTag from '../ui/BlinkingTag.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="hero" class="hero-section">
  <GlassEffect
    imageSrc="/hector.jpg"
    imageAlt="Héctor Jaraba - Staff Frontend Engineer"
    containerClass="absolute top-0 left-0 w-full h-full z-[-1]"
    enableScrollEffects={true}
  />
  <div id="hero-content" class="hero-content">
    <div id="home" class="hero-inner flex flex-col-reverse justify-end">
      <div class="max-w-4xl">
        <div class="flex flex-col gap-4 mb-5 sm:flex-row sm:gap-10">
          <p id="hero-label" class="hero-label" set:html={t('hero.label')} />
          <BlinkingTag
            >{t('hero.currentCompany')}
            <span class="font-semibold ml-1">{t('hero.companyName')}</span></BlinkingTag
          >
        </div>

        <p id="hero-title-main" class="hero-title text-3xl">
          {t('hero.title')}
        </p>
      </div>

      <span class="name uppercase whitespace-nowrap text-primary">Héctor Jaraba</span>
    </div>

    <div id="about" class="hero-inner justify-center gap-16 md:w-3/4 text-balanced">
      <p class="animate-text" set:html={t('hero.paragraph1')} />
      <p class="animate-text" set:html={t('hero.paragraph2')} />
      <div id="hero-ctas" class="flex items-center gap-8">
        <ShineButton id="more-about-me">
          <span>↬</span>
          {t('hero.moreAboutMe')}
        </ShineButton>
        <span class="text-base flex items-center gap-2">
          {t('hero.keepScrolling')}
          <svg
            id="scroll-arrow"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="inline-block scroll-arrow-bounce"
          >
            <path d="M12 5v14M19 12l-7 7-7-7"></path>
          </svg>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .name {
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
    z-index: 10;
  }

  .scroll-arrow-bounce {
    animation: bounce-down 1.2s ease-in-out infinite;
  }

  @keyframes bounce-down {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
    75% {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-arrow-bounce {
      animation: none;
    }
  }

  .animate-text {
    font-weight: bold;
    position: relative;
    color: #535353;
    --clip-value: 100%;
  }

  .animate-text::before {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 0;
    color: #fff;
    clip-path: inset(0 0 var(--clip-value) 0);
    will-change: clip-path;
    pointer-events: none;
  }

  .animate-text :global(.highlight-hero) {
    position: relative;
    color: #535353;
    display: inline-block;
    z-index: 1; /* Place above parent's ::before */
  }

  .animate-text :global(.highlight-hero)::before {
    content: attr(data-word);
    position: absolute;
    top: 0;
    left: 0;
    color: rgb(191, 186, 255);
    clip-path: inset(0 0 calc(var(--clip-value) / 1.3) 0);
    will-change: clip-path;
    pointer-events: none;
    z-index: 1;
  }

  .hero-section {
    position: relative;
    width: 100vw;
    height: 300vh;
    height: 300dvh;
    background: #000;
  }

  .hero-section::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    opacity: var(--hero-overlay-opacity, 0);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: left;
    justify-content: flex-start;
    padding: 2rem;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    position: relative;
    top: 0;
    overflow: visible;
    font-size: clamp(1.3rem, 4vw, 2.5rem);
    font-weight: 300;
    line-height: 1.4;
    color: #fff;
    margin-bottom: 4rem;
  }

  .hero-inner {
    text-align: left;
    height: 100vh;
    height: 100dvh;
    min-height: 100vh;
    min-height: 100dvh;
    position: absolute;
    top: 0;
    left: 2rem;
    display: flex;
    flex-direction: column;
    padding-top: 100px;
  }

  .hero-inner:nth-child(1) {
    padding-bottom: 2em;
  }

  .hero-inner:nth-child(2) {
    opacity: 0;
    pointer-events: none;
    padding-top: 120px;
  }

  .hero-label {
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.6;
  }

  .hero-title {
    font-weight: 300;
    line-height: 1.4;
    color: #fff;
    margin-bottom: 4rem;
    letter-spacing: -0.01em;
  }

  @media (max-width: 1268px) and (min-width: 1025px) {
    .hero-inner:nth-child(2) p {
      margin-bottom: 1rem;
      font-size: 2rem;
    }
  }

  @media (max-width: 1024px) and (min-width: 769px) {
    .hero-content {
      font-size: clamp(1.5rem, 3vw, 2rem);
      padding: 1.5rem;
    }

    .hero-inner {
      left: 1.5rem;
      right: 1.5rem;
      padding: 100px 1.5rem 2rem 1.5rem;
    }

    .hero-inner:nth-child(2) {
      padding-top: 120px;
      padding-bottom: 3rem;
      gap: 2.5rem;
    }

    .hero-inner:nth-child(2) p {
      margin-bottom: 1rem;
      font-size: 1.75rem;
    }

    .name {
      font-size: clamp(4rem, 8vw, 6rem);
    }

    .hero-label {
      font-size: 0.75rem;
    }

    .hero-title {
      font-size: 2rem;
    }
  }

  @media (max-width: 768px) {
    .hero-content {
      overflow: visible;
      font-size: clamp(1.25rem, 4.5vw, 1.8rem);
      line-height: 1.5;
      padding: 1rem;
    }

    .hero-inner {
      padding: 80px 1rem 1.5rem 1rem;
      left: 0.5rem;
      right: 0.5rem;
      height: auto;
      min-height: 100vh;
      min-height: 100dvh;
      gap: 1.5rem;
    }

    .hero-inner:nth-child(1) {
      padding-top: 90px;
    }

    .hero-inner:nth-child(2) {
      /* Keep the primary CTA inside the visible iOS viewport, above the home indicator. */
      justify-content: flex-start;
      padding-top: max(5rem, calc(env(safe-area-inset-top) + 3.75rem));
      padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
      gap: 1.25rem;
    }

    .hero-inner:nth-child(2) p {
      margin-bottom: 1.5rem;
    }

    .hero-inner:nth-child(2) p:last-of-type {
      margin-bottom: 0.5rem;
    }

    #hero-ctas {
      align-items: center;
      flex-wrap: nowrap;
      gap: clamp(0.5rem, 2.5vw, 0.875rem);
      margin-top: 0.25rem;
    }

    #hero-ctas :global(.shine-button) {
      min-height: 2.75rem;
    }

    #hero-ctas > span {
      flex: 1 1 auto;
      font-size: 0.8125rem;
      white-space: nowrap;
    }

    @media (max-width: 359px) {
      #hero-ctas {
        align-items: flex-start;
        flex-wrap: wrap;
      }

      #hero-ctas > span {
        flex-basis: 100%;
      }
    }

    .hero-label {
      font-size: 0.8rem;
    }

    .hero-title {
      font-size: 1.2rem;
      font-weight: 200;
      letter-spacing: 1.2px;
      margin-bottom: 3rem;
      line-height: 1.3;
      text-wrap: pretty;
    }

    .name {
      font-size: clamp(2.1rem, 8vw, 3rem);
      margin-bottom: 2rem;
    }
  }
</style>

<script>
  import { getGsap, getScrollTrigger } from '@/lib/gsap';
  import { onInit } from '@/lib/dom';

  const gsap = getGsap();
  const ScrollTrigger = getScrollTrigger();

  function initHeroAnimation() {
    const hero = document.getElementById('hero');
    const heroInners = hero?.querySelectorAll('.hero-inner');
    const texts = document.querySelectorAll('.animate-text');

    if (!hero || !heroInners || heroInners.length < 2) return;

    const [slide1, slide2] = heroInners;

    const startAnimation = () => {
      Array.from(slide1.children)
        .reverse()
        .forEach((child, index) => {
          gsap.from(child, {
            y: 20 * (index + 1),
            opacity: 0,
            duration: 1,
            delay: (index + 1) * 0.1,
          });
        });
    };

    document.addEventListener('loading-complete', startAnimation, { once: true });

    const tl = gsap.timeline({
      duration: 10,
      scrollTrigger: {
        trigger: hero,
        pin: true,
        pinSpacing: false,
        start: 'top top',
        end: '+=300%',
        scrub: 1,
      },
    });

    // iOS Safari changes the visible viewport when its browser chrome collapses.
    // Refresh after that transition so the pinned hero keeps its scroll bounds.
    let viewportRefreshTimeout: number | undefined;
    const refreshForViewportChange = () => {
      window.clearTimeout(viewportRefreshTimeout);
      viewportRefreshTimeout = window.setTimeout(() => ScrollTrigger.refresh(), 150);
    };

    window.visualViewport?.addEventListener('resize', refreshForViewportChange, {
      passive: true,
    });

    tl.to(
      slide1,
      {
        opacity: 0,
        y: -100,
        pointerEvents: 'none',
        duration: 0.3,
        ease: 'power2.inOut',
      },
      0
    );

    tl.to(
      hero,
      {
        '--hero-overlay-opacity': 1,
        duration: 0.3,
        ease: 'power2.inOut',
      },
      0.3
    );

    tl.fromTo(
      slide2,
      {
        opacity: 0,
        y: 100,
        pointerEvents: 'none',
      },
      {
        opacity: 1,
        y: 0,
        pointerEvents: 'auto',
        duration: 0.2,
        ease: 'power2.inOut',
      },
      0.3
    );

    texts.forEach((textElement, index) => {
      textElement.setAttribute('data-text', textElement.textContent.trim());

      const highlights = textElement.querySelectorAll('.highlight-hero');
      highlights.forEach((highlight) => {
        if (!highlight.getAttribute('data-word')) {
          highlight.setAttribute('data-word', highlight.textContent.trim());
        }
      });

      tl.fromTo(
        textElement,
        {
          '--clip-value': '100%',
        },
        {
          '--clip-value': '0%',
          duration: 0.15,
          ease: 'none',
        },
        0.5 + index * 0.15
      );
    });

    const moreAboutMeButton = document.getElementById('more-about-me');

    if (moreAboutMeButton) {
      tl.fromTo(
        '#hero-ctas',
        {
          opacity: 0,
          y: 20,
          filter: 'blur(10px)',
        },
        {
          opacity: 1,
          y: 0,
          duration: 0.1,
          filter: 'blur(0px)',
          ease: 'power2.inOut',
        },
        0.78
      );
    }

    tl.to(
      slide2,
      {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power2.inOut',
      },
      1
    );
  }

  onInit(initHeroAnimation);
</script>
