---
import { Image } from 'astro:assets';
import hectorGlassImage from '@/assets/images/hector-glass.png';
interface Props {
  imageSrc: string;
  imageAlt?: string;
  containerClass?: string;
  enableScrollEffects?: boolean;
}

const {
  imageSrc,
  imageAlt = 'Glass effect image',
  containerClass = '',
  enableScrollEffects = false,
} = Astro.props;
const instanceId = `glass-${Math.random().toString(36).substring(2, 11)}`;
---

<div
  class={`w-screen h-screen overflow-hidden bg-black ${containerClass}`}
  id="glass-effect"
  data-glass-id={instanceId}
  data-enable-scroll={enableScrollEffects}
  data-image-source={imageSrc}
>
  <div class="absolute inset-0 z-[1] will-change-transform pointer-events-none">
    <Image
      class="absolute inset-0 w-full h-full object-cover object-center opacity-50"
      src={hectorGlassImage}
      data-glass-image
      alt={imageAlt}
      loading="eager"
      fetchpriority="high"
      format="avif"
      quality={60}
      widths={[400, 640, 750, 828, 1080, 1200, 1920]}
      sizes="(max-width: 640px) 400px, (max-width: 768px) 640px, (max-width: 1024px) 828px, 100vw"
    />
  </div>

  <div class="absolute inset-0 z-[2] pointer-events-none hidden md:block">
    <canvas data-glass-canvas class="w-full h-full block opacity-100 mix-blend-normal"></canvas>
  </div>
  <div
    class="absolute inset-0"
    style="background: rgb(var(--accent-purple-rgb) / 0.18); mix-blend-mode: multiply;"
  >
  </div>
  <div class="absolute inset-0 z-[3] flex items-center justify-center pointer-events-none">
    <div class="pointer-events-auto">
      <slot />
    </div>
  </div>
</div>

<script>
  import { useDevices } from '@/lib/devices';
  import { onInit } from '@/lib/dom';

  function supportsAcceleratedWebGL() {
    const testCanvas = document.createElement('canvas');
    const gl = testCanvas.getContext('webgl');
    if (!gl) return false;

    const debugInfo = gl.getExtension('WEBGL_debug_renderer_info');
    const renderer = debugInfo
      ? String(gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL)).toLowerCase()
      : '';
    gl.getExtension('WEBGL_lose_context')?.loseContext();

    // Software rasterizers turn this full-viewport effect into a long task.
    // The eager image below is intentionally the complete visual fallback.
    return !/(swiftshader|software|llvmpipe|mesa offscreen)/.test(renderer);
  }

  async function initGlassEffects() {
    const containers = document.querySelectorAll('[data-glass-id]');
    const { isAbleToRunEffects } = useDevices();
    if (!isAbleToRunEffects || !containers.length || !supportsAcceleratedWebGL()) return;

    const [{ GlassEffect }, { getScrollTrigger }] = await Promise.all([
      import('@/lib/webgl/glass-effect'),
      import('@/lib/gsap'),
    ]);
    const ScrollTrigger = getScrollTrigger();

    for (const container of containers) {
      if ((container as HTMLElement).dataset.initialized === 'true') continue;

      const canvas = container.querySelector('[data-glass-canvas]') as HTMLCanvasElement;
      const image = container.querySelector('[data-glass-image]') as HTMLImageElement;
      const enableScroll = container.getAttribute('data-enable-scroll') === 'true';

      if (!canvas || !image) continue;
      (container as HTMLElement).dataset.initialized = 'true';

      try {
        // Reuse the hero image already decoded for the visible fallback.
        // This avoids an additional 1600px texture request and a blocking decode.
        if (!image.complete || !image.naturalWidth) {
          await new Promise<void>((resolve, reject) => {
            image.addEventListener('load', () => resolve(), { once: true });
            image.addEventListener('error', () => reject(new Error('Failed to load glass texture')), {
              once: true,
            });
          });
        }

        // Create WebGL effect with the decoded fallback image.
        const effect = new GlassEffect(canvas, image);

        // Add scroll-triggered zoom if enabled
        if (enableScroll) {
          ScrollTrigger.create({
            trigger: container,
            start: 'top top',
            end: 'bottom top',
            scrub: true,
            onUpdate: (self) => {
              const progress = self.progress;
              // Zoom from 1.5 to 2.0 based on scroll
              const zoom = 1.0 + progress * -0.5;
              effect.updateConfig({ textureScale: zoom });

              // Increase distortion effects on scroll
              effect.updateConfig({
                displacementAmplitude: 0.005 + progress * 0.055,
                warpAmplitude: 0.022 + progress * 0.028,
                blurAmount: 0.009 + progress * 0.001,
                autoMoveAmplitude: 0.046 + progress * 0.054,
              });
            },
          });
        }

        // Store effect instance for external control
        (container as any).glassEffect = effect;
      } catch (error) {
        console.warn('Failed to load image or create WebGL effect:', error);
      }
    }
  }

  function scheduleGlassEffects() {
    let started = false;

    const start = () => {
      if (started) return;
      started = true;
      window.removeEventListener('pointermove', start);
      window.removeEventListener('pointerdown', start);
      window.removeEventListener('keydown', start);
      window.removeEventListener('scroll', start);
      void initGlassEffects();
    };

    // Keep the eager, visually identical image as the first paint. WebGL only
    // adds interaction-driven distortion, so it can wait for visitor intent.
    window.addEventListener('pointermove', start, { once: true, passive: true });
    window.addEventListener('pointerdown', start, { once: true, passive: true });
    window.addEventListener('keydown', start, { once: true });
    window.addEventListener('scroll', start, { once: true, passive: true });
  }

  // WebGL enhances the already-visible image, so keep it off the critical render path.
  onInit(scheduleGlassEffects);
</script>
